# Copy this file to .env to customize. All values are optional — if you don't create
# a .env, the server auto-generates one on first run (see src/env.js) with PORT=8787,
# a random JWT_SECRET, and MONGODB_URI pointing at a local MongoDB on the default port.

# Port the API listens on.
PORT=8787

# Secret used to sign login sessions (JWT). Keep this secret in real deployments.
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB connection string. Needs a MongoDB server reachable at this URI — a local
# install (mongodb://127.0.0.1:27017/sikshapaper) or a hosted one (e.g. MongoDB Atlas).
# Everything is stored here: users, each saved file's metadata, AND the file bytes
# themselves (via GridFS, in the "files" bucket) — no separate disk storage or SQL DB.
MONGODB_URI=mongodb://127.0.0.1:27017/sikshapaper

# Only browser requests whose Origin header matches one of these (comma-separated for
# more than one, e.g. your deployed frontend's URL) get CORS-allowed; everything else
# (curl, server-to-server calls) is unaffected since only browsers send an Origin header.
FRONTEND_ORIGIN=http://localhost:5173

# --- Server-side document conversion (all optional; see README "High-fidelity conversion") ---
# Needs LibreOffice (soffice) and Python with pdf2docx, pdfplumber, openpyxl on this machine.
# SOFFICE_PATH=soffice            # full path if soffice isn't on PATH (Windows/Mac)
# PYTHON_BIN=python3              # "python" on Windows
# CONVERT_MAX_MB=50               # max upload size per file
# CONVERT_TIMEOUT_MS=120000       # kill a conversion that takes longer than this
# CONVERT_CONCURRENCY=2           # conversions run at the same time
# CONVERT_MAX_QUEUE=20            # extra requests allowed to wait before "server busy"
