# Frontend env — copy to .env.local for local overrides (not needed for normal local dev).
#
# Leave VITE_API_BASE unset/empty when the frontend calls the backend on the SAME domain
# (local dev via the Vite proxy in vite.config.ts, or the combined single-Vercel-project
# setup) — relative "/api/..." calls just work.
#
# Set it only when the frontend is deployed SEPARATELY from the backend (e.g. frontend on
# Vercel, backend on Render) — point it at wherever the backend actually lives:
VITE_API_BASE=https://your-backend-host.onrender.com

# Note: this is the mirror-image of backend/.env's FRONTEND_ORIGIN — that one tells the
# BACKEND which frontend URL to accept requests from; this one tells the FRONTEND which
# backend URL to send requests to. Set both, each pointing at the other's real URL, when
# they're deployed on two different hosts/domains.
